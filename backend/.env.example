# ── Database ──────────────────────────────────
# Local:   postgresql://user:@localhost:5432/smartbot_v2
# Railway: provided automatically by Railway PostgreSQL plugin
DATABASE_URL=

# ── LLM ───────────────────────────────────────
# Leave blank → uses Ollama locally (llama3.2:1b)
# Set to use Groq on Railway
GROQ_API_KEY=
LLM_MODEL=llama-3.1-8b-instant

# ── Embeddings ────────────────────────────────
# Leave blank → uses FakeEmbeddings (dev only)
# Set to use HuggingFace Inference API
HUGGINGFACE_API_KEY=
EMBED_MODEL=all-MiniLM-L6-v2

# ── Vector DB ─────────────────────────────────
# Leave blank → uses local ChromaDB
# Set both to use Pinecone (Railway/demo)
PINECONE_API_KEY=
PINECONE_INDEX=smartbot-docs

# ── Auth ──────────────────────────────────────
JWT_SECRET_KEY=change-this-in-production

# ── Admin ─────────────────────────────────────
ADMIN_DEFAULT_EMAIL=admin@smartbot.com
ADMIN_DEFAULT_PASSWORD=Admin@SmartBot2025!

# ── App ───────────────────────────────────────
APP_NAME=SmartBot
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Notifications (optional) ──────────────────
TEAMS_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
